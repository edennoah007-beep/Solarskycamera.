<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera viewfinder (clipped so extra digital zoom does not spill) -->
    <FrameLayout
        android:id="@+id/previewHolder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true">

        <androidx.camera.view.PreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- AR labels, target box, horizon, arrows -->
    <com.solarsky.camera.ArOverlayView
        android:id="@+id/arOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Zoom map box (like Galaxy "Zoom Map") -->
    <com.solarsky.camera.ZoomMapView
        android:id="@+id/zoomMap"
        android:layout_width="120dp"
        android:layout_height="200dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="64dp"
        android:visibility="gone" />

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/infoText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:shadowColor="#000000"
            android:shadowRadius="4"
            android:text="Solar Sky Camera"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnSky"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_bg"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="★ SKY MAP"
            android:textColor="#FFC94D"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Exposure buttons (right side) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/btnEvUp"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_bg"
            android:gravity="center"
            android:text="☀+"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/evText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:shadowColor="#000000"
            android:shadowRadius="4"
            android:text="EV 0"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnEvDown"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_bg"
            android:gravity="center"
            android:text="☀−"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Bottom controls -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#88000000"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/zoomText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1.0x"
            android:textColor="#FFC94D"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/zoomDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text=""
            android:textColor="#CCCCCC"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/zoomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="4dp"
            android:max="1000" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/quickZoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnGallery"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/btn_bg"
                android:gravity="center"
                android:text="▣ LAST"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/btnTimer"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/btn_bg"
                android:gravity="center"
                android:text="⏱ OFF"
                android:textColor="#FFFFFF" />

            <View
                android:id="@+id/btnShutter"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/shutter_photo" />

            <TextView
                android:id="@+id/btnMode"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/btn_bg"
                android:gravity="center"
                android:text="PHOTO"
                android:textColor="#FFC94D"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnLabels"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:background="@drawable/btn_bg"
                android:gravity="center"
                android:text="AR ON"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- White flash when photo taken -->
    <View
        android:id="@+id/flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#FFFFFF" />

    <!-- Full screen star map -->
    <FrameLayout
        android:id="@+id/skyPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#05081A"
        android:visibility="gone">

        <com.solarsky.camera.SkyMapView
            android:id="@+id/skyMap"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/btnCloseSky"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:background="@drawable/btn_bg"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="◉ CAMERA"
            android:textColor="#FFC94D"
            android:textStyle="bold" />
    </FrameLayout>
</FrameLayout>
